# ============================================
# AgentForge 环境变量配置
# ============================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================

# 应用配置
ENVIRONMENT=development
APP_NAME=AgentForge
DEBUG=true

# ============================================
# 数据库配置
# ============================================
# 开发环境使用 SQLite
DB_TYPE=sqlite
DATABASE_URL=sqlite:///data/agentforge.db

# 生产环境使用 PostgreSQL
# DB_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@localhost/agentforge

# ============================================
# JWT 配置（必须修改！）
# ============================================
# 生成强密钥: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ============================================
# 加密配置（必须修改！）
# ============================================
# 生成强密钥: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-here-change-me
ENCRYPTION_SALT=agentforge-salt

# ============================================
# LLM API Keys（可选，也可在前端配置）
# ============================================
# Kimi (Moonshot)
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================
# Redis 配置（可选）
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# ChromaDB 配置
# ============================================
CHROMA_PERSIST_DIR=./data/chromadb

# ============================================
# 监控配置
# ============================================
ENABLE_MONITORING=true
METRICS_RETENTION_DAYS=30

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
